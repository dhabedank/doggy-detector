# Optional first-run dashboard credentials. Leave unset to let the app generate
# credentials on first startup and print them to the service logs.
DOG_DETECTOR_AUTH_USERNAME=
DOG_DETECTOR_AUTH_PASSWORD=

# Optional runtime data directory. Defaults to ./data.
DOG_DETECTOR_DATA_DIR=

# Set to 1 for a one-time local credential reset.
DOG_DETECTOR_RESET_AUTH=0
